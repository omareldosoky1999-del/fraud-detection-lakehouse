# Copy to .env and adjust. Never commit .env.
# --- addresses as seen from the HOST (producer / generator / tests) ---
KAFKA_BOOTSTRAP=localhost:29092
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- topics ---
TOPIC_TRANSACTIONS=transactions
TOPIC_DLQ=transactions.dlq
TOPIC_ALERTS=fraud.alerts

# --- files ---
LABELS_PATH=labels/ground_truth.csv
PRODUCER_CHECKPOINT=.state/producer_checkpoint.json

# local admin credentials for optional UI services
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
MLFLOW_TRACKING_URI=http://localhost:5000
ICEBERG_FILEIO_IMPL=org.apache.iceberg.aws.s3.S3FileIO
